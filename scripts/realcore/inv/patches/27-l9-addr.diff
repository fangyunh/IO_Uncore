@@ -325,9 +325,9 @@
 #define INV_F_REC64	0x10u	/* 23-l3-rec: 64 B Mode D records (one per line) */
 #define INV_F_REC32	0x20u	/* 23-l3-rec: LOCKED 32 B records through the lever loops (control) */
 #define INV_F_DESC	0x40u	/* 25-l6-desc: Mode D descriptor at inv_desc_b bytes (32|40|64) */
-/* 0x80u: later levers */
+#define INV_F_ADDR	0x80u	/* 27-l9-addr: Mode D descriptor w2 carries the data address (inv_addr_b) */
 /* inv_flags bits that divert nvme_pcie_qpair_submit_request into inv_submit_lever(). */
-#define INV_F_SUBMIT	(INV_F_TRFREE | INV_F_DESC)
