+/* inv 22-l2-thin ----------------------------------------------------------------------------- */
+
+SPDK_STATIC_ASSERT(offsetof(struct spdk_nvme_cmd, nsid) == 4, "SQE layout");
+SPDK_STATIC_ASSERT(offsetof(struct spdk_nvme_cmd, dptr.prp.prp1) == 24, "SQE layout");
+SPDK_STATIC_ASSERT(offsetof(struct spdk_nvme_cmd, cdw10) == 40, "SQE layout");
+SPDK_STATIC_ASSERT(offsetof(struct spdk_nvme_cmd, cdw12) == 48, "SQE layout");
+
+/* B-thin: build the 64 B read SQE straight in the SQ slot from registers, with the stock copy's
+ * four 16 B streaming stores: {dw0 = opc | cid << 16 (fuse 0, PRP), nsid | cdw2-3 0},
+ * {mptr 0 | prp1}, {prp2 0 | cdw10-11 = slba}, {cdw12 = nlb - 1, cdw13 0 | cdw14-15 0}. */
+static inline void
+inv_thin_write_sqe(struct spdk_nvme_cmd *slot, uint16_t cid, uint32_t nsid, uint64_t lba,
+		   uint32_t nlb, uint64_t prp1)
+{
+	const uint64_t dw01 = (uint64_t)SPDK_NVME_OPC_READ | ((uint64_t)cid << 16) |
+			      ((uint64_t)nsid << 32);
+	const uint64_t dw1213 = (uint64_t)((nlb - 1) & 0xFFFFu);
+#if defined(__SSE2__)
+	__m128i *d128 = (__m128i *)slot;
+
+	_mm_stream_si128(&d128[0], _mm_set_epi64x(0, (long long)dw01));
+	_mm_stream_si128(&d128[1], _mm_set_epi64x((long long)prp1, 0));
+	_mm_stream_si128(&d128[2], _mm_set_epi64x((long long)lba, 0));
+	_mm_stream_si128(&d128[3], _mm_set_epi64x(0, (long long)dw1213));
+#else
+	uint64_t *q = (uint64_t *)slot;
+
+	q[0] = dw01;
+	q[1] = 0;
+	q[2] = 0;
+	q[3] = prp1;
+	q[4] = 0;
+	q[5] = lba;
+	q[6] = dw1213;
+	q[7] = 0;
+#endif
+}
+
+static int __attribute__((noinline, cold))
+inv_thin_missing(struct spdk_nvme_qpair *qpair)
+{
+	static bool inv_warned;
+
+	if (!inv_warned) {
+		inv_warned = true;
+		NVME_QPAIR_ERRLOG(qpair, "inv thin: qpair %u has no thin state (SPDK_INV_THIN "
+				  "unset for the library, or not mode 0 / Mode D without E)\n",
+				  qpair->id);
+	}
+	return -ENXIO;
+}
+
+/* One read, no nvme_request, no tracker. I-thin (Mode D) writes the stock-packed descriptor;
+ * B-thin keeps the callback in the per-cid context and writes the SQE. Both take the cid from
+ * the same LIFO stack and batch the SQ doorbell exactly like their stock paths. UNSAFE oracle. */
+int
+spdk_nvme_inv_thin_read(struct spdk_nvme_qpair *qpair, uint32_t nsid, uint64_t lba, uint32_t nlb,
+			uint64_t buf_iova, spdk_nvme_cmd_cb cb_fn, void *cb_arg)
+{
+	struct nvme_pcie_qpair *pqpair = nvme_pcie_qpair(qpair);
+	const uint8_t inv = pqpair->inv_flags;
+	uint16_t cid;
+
+	if (spdk_unlikely(!(inv & INV_F_THIN))) {
+		return inv_thin_missing(qpair);
+	}
+	if (spdk_unlikely(pqpair->inv_thin_top == 0)) {
+		pqpair->stat->queued_requests++;
+		return -EAGAIN;
+	}
+	cid = pqpair->inv_thin_stack[--pqpair->inv_thin_top];
+	if (inv & INV_F_ITHIN) {
+		/* I-thin: the stock Mode D packing (w0 = {opc, fuse 0, cid, nlb - 1, control 0},
+		 * w1 = slba, no data address: D1); the device echoes w4 (cb_fn) into record w0 and
+		 * w3 (cb_arg) into record w1. */
+		struct nvme_uncore_sq_desc_d *ring_d =
+			(struct nvme_uncore_sq_desc_d *)pqpair->sq_desc_ring;
+		uint32_t _idx = pqpair->sq_desc_tail;
+
+		ring_d[_idx].w0 = ((uint64_t)SPDK_NVME_OPC_READ << 56) | ((uint64_t)cid << 32) |
+				  ((uint64_t)((nlb - 1) & 0xFFFFu) << 16);
+		ring_d[_idx].w1 = lba;
+		ring_d[_idx].w2 = 0;
+		ring_d[_idx].w3 = (uint64_t)(uintptr_t)cb_arg;
+		ring_d[_idx].w4 = (uint64_t)(uintptr_t)cb_fn;
+		pqpair->sq_desc_tail = (_idx + 1 == pqpair->num_entries) ? 0 : _idx + 1;
+		if (!pqpair->flags.delay_cmd_submit) {
+			nvme_pcie_qpair_ring_sq_doorbell(qpair);
+			pqpair->last_sq_desc_tail = pqpair->sq_desc_tail;
+		}
+	} else {
+		/* B-thin: PRP1 = the buffer address the app translated once at init. */
+		struct inv_thin_ctx *ctx = &pqpair->inv_thin[cid];
+
+		ctx->cb_fn = cb_fn;
+		ctx->cb_arg = cb_arg;
+		inv_thin_write_sqe(&pqpair->cmd[pqpair->sq_tail], cid, nsid, lba, nlb, buf_iova);
+		if (spdk_unlikely(++pqpair->sq_tail == pqpair->num_entries)) {
+			pqpair->sq_tail = 0;
+		}
+		/* Stock submit_tracker rings at once without touching last_sq_tail. */
+		if (!pqpair->flags.delay_cmd_submit) {
+			nvme_pcie_qpair_ring_sq_doorbell(qpair);
+		}
+	}
+	return 0;
+}
+
 struct spdk_nvme_transport_poll_group *
 nvme_pcie_poll_group_create(void)
 {
diff -ruN a/lib/nvme/nvme_pcie_internal.h b/lib/nvme/nvme_pcie_internal.h
--- a/lib/nvme/nvme_pcie_internal.h	2026-10-14 00:52:18.181821466 +0000
+++ b/lib/nvme/nvme_pcie_internal.h	2026-10-14 00:52:18.191248265 +0000
@@ -319,7 +319,15 @@
  * - A lever whose bit reaches inv_process_completions() must handle its completions there.
  */
 #define INV_F_TRFREE	0x01u	/* 20-l1-trfree: Mode D, cid stack, req rides in w4 */
-/* 0x02u..0x80u: later levers */
+#define INV_F_THIN	0x02u	/* 22-l2-thin: B-thin or I-thin (thin state allocated) */
+#define INV_F_ITHIN	0x04u	/* 22-l2-thin: I-thin (Mode D descriptors and records) */
+/* 0x08u..0x80u: later levers */
+
+/* inv 22-l2-thin (oracle): per-cid callback context for the thin baseline path (B-thin). */
+struct inv_thin_ctx {
+	spdk_nvme_cmd_cb	cb_fn;
+	void			*cb_arg;
+};
 
 /* PCIe transport extensions for spdk_nvme_qpair */
 struct nvme_pcie_qpair {
@@ -448,8 +456,20 @@
 	uint16_t *inv_cid_stack;
 	uint32_t inv_cid_top;
 	uint32_t inv_cid_cap;
+	/* 22-l2-thin: one LIFO cid stack for both arms plus B-thin's per-cid callback context
+	 * (I-thin gets cb_fn/cb_arg back in the record); valid when inv_flags & INV_F_THIN. */
+	struct inv_thin_ctx *inv_thin;
+	uint16_t *inv_thin_stack;
+	uint32_t inv_thin_top;
+	uint32_t inv_thin_cap;
+	uint64_t inv_thin_extra;	/* completions whose cid found the stack full */
 };
 
+/* inv 22-l2-thin: one read with no nvme_request and no tracker (UNSAFE oracle, see the patch
+ * header). Returns 0, -EAGAIN (no free cid) or -ENXIO (the qpair has no thin state). */
+int spdk_nvme_inv_thin_read(struct spdk_nvme_qpair *qpair, uint32_t nsid, uint64_t lba,
+			    uint32_t nlb, uint64_t buf_iova, spdk_nvme_cmd_cb cb_fn, void *cb_arg);
+
 #ifdef SPDK_NVME_IO_CYCLE_OFF
 /* inv: lever state must not move a stock field (lean layout: flags at 109, qpair at 112). */
 SPDK_STATIC_ASSERT(offsetof(struct nvme_pcie_qpair, inv_flags) == 110, "inv_flags left the hole");
