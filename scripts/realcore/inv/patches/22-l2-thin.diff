+/* inv 22-l2-thin: SPDK_INV_THIN=1 selects this table once in register_ns(), so the stock
+ * nvme_fn_table and nvme_submit_io stay untouched. Every IO goes through
+ * spdk_nvme_inv_thin_read(): a thin qpair must never see a generic-path request (its tracker cid
+ * would collide with the thin stack), so anything the thin call cannot carry fails loudly. */
+static void
+nvme_thin_setup_payload(struct perf_task *task, uint8_t pattern)
+{
+	struct ns_entry *entry = task->ns_ctx->entry;
+	void *buf;
+
+	nvme_setup_payload(task, pattern);	/* g_io_align is >= 4 KiB while thin is on (main) */
+	buf = task->iovs[0].iov_base;
+	/* One PRP entry: one iovec, a page-aligned buffer, at most 4 KiB, no metadata, no flags. */
+	if (task->iovcnt != 1 || entry->md_size != 0 || entry->io_flags != 0 ||
+	    g_io_size_bytes > 0x1000u || ((uintptr_t)buf & 0xFFFu) != 0) {
+		fprintf(stderr, "inv thin: ERROR: SPDK_INV_THIN=1 needs single-PRP IO (iovcnt=%d "
+			"md_size=%u io_flags=0x%x io_size=%u buf=%p)\n", task->iovcnt,
+			entry->md_size, entry->io_flags, g_io_size_bytes, buf);
+		exit(1);
+	}
+	/* Translate once, as nvme_pcie_vtophys() would: PCIe = spdk_vtophys, vfio-user = VA. */
+	if (spdk_nvme_ctrlr_get_transport_id(entry->u.nvme.ctrlr)->trtype ==
+	    SPDK_NVME_TRANSPORT_PCIE) {
+		task->inv_iova = spdk_vtophys(buf, NULL);
+		if (task->inv_iova == SPDK_VTOPHYS_ERROR) {
+			fprintf(stderr, "inv thin: ERROR: spdk_vtophys(%p) failed\n", buf);
+			exit(1);
+		}
+	} else {
+		task->inv_iova = (uint64_t)(uintptr_t)buf;
+	}
+}
+
+/* A write (or a qpair without thin state): fail the ns_ctx and stop submitting, so an IO the
+ * thin path cannot carry is neither sent down the generic path nor requeued forever by -Q. */
+static int __attribute__((noinline, cold))
+inv_thin_fail(struct perf_task *task, struct ns_worker_ctx *ns_ctx, int rc)
+{
+	static bool warned;
+
+	if (!__atomic_exchange_n(&warned, true, __ATOMIC_RELAXED)) {
+		fprintf(stderr, "inv thin: ERROR: IO not submitted (is_read=%d rc=%d); "
+			"SPDK_INV_THIN=1 carries single-PRP reads on thin qpairs only\n",
+			(int)task->is_read, rc);
+	}
+	ns_ctx->status = 1;
+	ns_ctx->is_draining = true;
+	return rc;
+}
+
+static int
+nvme_thin_submit_io(struct perf_task *task, struct ns_worker_ctx *ns_ctx,
+		    struct ns_entry *entry, uint64_t offset_in_ios)
+{
+	int qp_num;
+	int rc;
+
+	qp_num = ns_ctx->u.nvme.last_qpair;
+	ns_ctx->u.nvme.last_qpair++;
+	if (ns_ctx->u.nvme.last_qpair == ns_ctx->u.nvme.num_active_qpairs) {
+		ns_ctx->u.nvme.last_qpair = 0;
+	}
+	if (spdk_unlikely(!task->is_read)) {
+		return inv_thin_fail(task, ns_ctx, -ENOTSUP);
+	}
+	rc = spdk_nvme_inv_thin_read(ns_ctx->u.nvme.qpair[qp_num], ns_ctx->inv_nsid,
+				     offset_in_ios * entry->io_size_blocks, entry->io_size_blocks,
+				     task->inv_iova, io_complete, task);
+	if (spdk_unlikely(rc != 0 && rc != -EAGAIN)) {
+		return inv_thin_fail(task, ns_ctx, rc);
+	}
+	return rc;	/* -EAGAIN: no free cid (QD per qpair > num_trackers) */
+}
+
+static int
+nvme_thin_init_ns_worker_ctx(struct ns_worker_ctx *ns_ctx)
+{
+	ns_ctx->inv_nsid = spdk_nvme_ns_get_id(ns_ctx->entry->u.nvme.ns);
+	return nvme_init_ns_worker_ctx(ns_ctx);
+}
+
+static const struct ns_fn_table nvme_thin_fn_table = {
+	.setup_payload		= nvme_thin_setup_payload,
+	.submit_io		= nvme_thin_submit_io,
+	.check_io		= nvme_check_io,
+	.verify_io		= nvme_verify_io,
+	.init_ns_worker_ctx	= nvme_thin_init_ns_worker_ctx,
+	.cleanup_ns_worker_ctx	= nvme_cleanup_ns_worker_ctx,
+	.dump_transport_stats	= nvme_dump_transport_stats
+};
