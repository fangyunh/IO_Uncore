+/* inv 22-l2-thin: return a cid to the shared stack. A push onto a full stack (a duplicate or bogus
+ * completion) is counted, never written, and reported at destroy. */
+static inline void
+inv_thin_push(struct nvme_pcie_qpair *pqpair, uint16_t cid)
+{
+	if (spdk_likely(pqpair->inv_thin_top < pqpair->inv_thin_cap)) {
+		pqpair->inv_thin_stack[pqpair->inv_thin_top++] = cid;
+	} else {
+		pqpair->inv_thin_extra++;
+	}
+}
+
+/* inv 22-l2-thin (I-thin): the record carries the callback; recycle the cid, call back. */
+static uint32_t
+inv_records_ithin(struct nvme_pcie_qpair *pqpair, uint32_t max_completions)
+{
+	uint64_t rec_cb_fn, rec_cb_arg, cpl_lo, cpl_hi;
+	uint32_t num_completions = 0;
+
+	while (inv_rec_pop(pqpair, &rec_cb_fn, &rec_cb_arg, &cpl_lo, &cpl_hi)) {
+		struct spdk_nvme_cpl cpl_rec;
+
+		memcpy((uint8_t *)&cpl_rec + 0, &cpl_lo, 8);
+		memcpy((uint8_t *)&cpl_rec + 8, &cpl_hi, 8);
+		inv_thin_push(pqpair, (uint16_t)((cpl_hi >> 32) & 0xFFFFu));
+		((spdk_nvme_cmd_cb)(uintptr_t)rec_cb_fn)((void *)(uintptr_t)rec_cb_arg, &cpl_rec);
+		if (++num_completions == max_completions) {
+			break;
+		}
+	}
+	return num_completions;
+}
+
+/* inv 22-l2-thin (B-thin): the stock CQ loop's bookkeeping (phase bit, next-entry check and
+ * prefetch, cq_head and phase advance, sq_head) with the per-cid context in place of the
+ * tracker. */
+static uint32_t
+inv_cqes_bthin(struct nvme_pcie_qpair *pqpair, uint32_t max_completions)
+{
+	struct spdk_nvme_cpl *cpl, *next_cpl;
+	uint32_t num_completions = 0;
+	uint16_t next_cq_head;
+	uint8_t next_phase;
+	bool next_is_valid = false;
+
+	while (1) {
+		const struct inv_thin_ctx *ctx;
+		spdk_nvme_cmd_cb cb_fn;
+		void *cb_arg;
+
+		cpl = &pqpair->cpl[pqpair->cq_head];
+		if (!next_is_valid && cpl->status.p != pqpair->flags.phase) {
+			break;
+		}
+		if (spdk_likely(pqpair->cq_head + 1 != pqpair->num_entries)) {
+			next_cq_head = pqpair->cq_head + 1;
+			next_phase = pqpair->flags.phase;
+		} else {
+			next_cq_head = 0;
+			next_phase = !pqpair->flags.phase;
+		}
+		next_cpl = &pqpair->cpl[next_cq_head];
+		next_is_valid = (next_cpl->status.p == next_phase);
+		if (next_is_valid) {
+			__builtin_prefetch(&pqpair->inv_thin[next_cpl->cid]);
+		}
+#if defined(__PPC64__) || defined(__riscv) || defined(__loongarch__)
+		spdk_mb();
+#elif defined(__aarch64__)
+		__asm volatile("dmb oshld" ::: "memory");
+#endif
+		if (spdk_unlikely(++pqpair->cq_head == pqpair->num_entries)) {
+			pqpair->cq_head = 0;
+			pqpair->flags.phase = !pqpair->flags.phase;
+		}
+		pqpair->sq_head = cpl->sqhd;
+		ctx = &pqpair->inv_thin[cpl->cid];
+		cb_fn = ctx->cb_fn;
+		cb_arg = ctx->cb_arg;
+		inv_thin_push(pqpair, cpl->cid);
+		cb_fn(cb_arg, cpl);
+		if (++num_completions == max_completions) {
+			break;
+		}
+	}
+	return num_completions;
+}
