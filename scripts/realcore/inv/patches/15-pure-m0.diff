-			if (pqpair->last_sq_desc_tail != pqpair->sq_desc_tail) {
-				nvme_pcie_qpair_ring_sq_doorbell(qpair);
-				nvme_pcie_qpair_mark_doorbell_time(pqpair, nvme_io_cycle_rdtsc());
