+/* inv: consume one Mode D record exactly like the stock loop (phase bit, the four words in the
+ * stock order, cursor advance with phase toggle). Returns false when no new record is visible. */
+static inline bool
+inv_rec_pop(struct nvme_pcie_qpair *pqpair, uint64_t *cb_fn, uint64_t *cb_arg, uint64_t *cpl_lo,
+	    uint64_t *cpl_hi)
+{
+	volatile struct nvme_uncore_cq_cb_rec *ring =
+		(volatile struct nvme_uncore_cq_cb_rec *)pqpair->cq_rec_ring;
+	volatile struct nvme_uncore_cq_cb_rec *rec = &ring[pqpair->cq_rec_head];
+	uint64_t hi = rec->cpl_hi;
+
+	if (((uint8_t)((hi >> 48) & 0x1u)) != pqpair->cq_rec_phase) {
+		return false;
+	}
+	*cb_fn = rec->cb_fn;
+	*cb_arg = rec->cb_arg;
+	*cpl_lo = rec->cpl_lo;
+	*cpl_hi = hi;
+	if (spdk_unlikely(++pqpair->cq_rec_head == pqpair->num_entries)) {
+		pqpair->cq_rec_head = 0;
+		pqpair->cq_rec_phase = !pqpair->cq_rec_phase;
+	}
+	return true;
+}
+
+/* inv 20-l1-trfree: record w0 echoes the nvme_request (descriptor w4); no tracker is touched. */
+static uint32_t
+inv_records_trfree(struct nvme_pcie_qpair *pqpair, uint32_t max_completions)
+{
+	uint64_t rec_cb_fn, rec_cb_arg, cpl_lo, cpl_hi;
+	uint32_t num_completions = 0;
+
+	while (inv_rec_pop(pqpair, &rec_cb_fn, &rec_cb_arg, &cpl_lo, &cpl_hi)) {
+		struct nvme_request *req = (struct nvme_request *)(uintptr_t)rec_cb_fn;
+		uint16_t cid = (uint16_t)((cpl_hi >> 32) & 0xFFFFu);
+		struct spdk_nvme_cpl cpl_rec;
+
+		memcpy((uint8_t *)&cpl_rec + 0, &cpl_lo, 8);
+		memcpy((uint8_t *)&cpl_rec + 8, &cpl_hi, 8);
+		assert(cid < pqpair->inv_cid_cap);
+		if (spdk_likely(pqpair->inv_cid_top < pqpair->inv_cid_cap)) {
+			pqpair->inv_cid_stack[pqpair->inv_cid_top++] = cid;
+		} else {
+			/* duplicate or bogus record: counted, reported at destroy */
+			pqpair->inv_cid_extra++;
+		}
+		pqpair->qpair.queue_depth--;
+		req->cb_fn((void *)(uintptr_t)rec_cb_arg, &cpl_rec);
+		nvme_free_request(req);
+		if (++num_completions == max_completions) {
+			break;
+		}
+	}
+	return num_completions;
+}
+
+static void __attribute__((noinline, cold))
+inv_no_completion_path(struct nvme_pcie_qpair *pqpair, uint8_t inv, bool mode_d)
+{
+	static bool inv_warned;
+
+	if (!inv_warned) {
+		inv_warned = true;
+		NVME_QPAIR_ERRLOG(&pqpair->qpair,
+				  "inv: no completion path for inv_flags 0x%x mode_d %d\n",
+				  inv, (int)mode_d);
+	}
+}
+
+/* inv: the lever completion loops, entered only when inv_flags != 0. Each returns the
+ * number of completions; the caller's shared poll tail (stats, CQ doorbell, SQ doorbell
+ * batching, timeouts) runs unchanged afterwards. */
+static uint32_t __attribute__((noinline, hot))
+inv_process_completions(struct nvme_pcie_qpair *pqpair, uint32_t max_completions, bool mode_d,
+			uint8_t inv)
+{
+	if (mode_d && (inv & INV_F_TRFREE)) {
+		return inv_records_trfree(pqpair, max_completions);
+	}
+	inv_no_completion_path(pqpair, inv, mode_d);
+	return 0;
+}
+
+/* inv: cold, noinline trampoline (a single jmp). Calling the lever loops through it puts the
+ * call in .text.unlikely, so GCC keeps the stock block layout of the poll function. The lever
+ * loops are marked hot so GCC does not infer them cold (and size-optimize them) from their
+ * only caller. */
+static uint32_t __attribute__((noinline, cold))
+inv_completions_trampoline(struct nvme_pcie_qpair *pqpair, uint32_t max_completions, bool mode_d,
+			   uint8_t inv)
+{
+	return inv_process_completions(pqpair, max_completions, mode_d, inv);
+}
