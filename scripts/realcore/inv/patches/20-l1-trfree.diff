+
 	/*
 	 * Base qpair structure.
 	 * This is located after the hot data in this structure so that the important parts of
@@ -424,8 +441,21 @@
 	uint64_t  free_slot_ring_bus_addr;
 	uint32_t  free_slot_head;
 	uint8_t   free_slot_phase;
+
+	/* inv lever state (tail; see the architecture note above). */
+	/* 20-l1-trfree: compact LIFO cid stack, valid when inv_flags & INV_F_TRFREE. */
+	uint64_t inv_cid_extra;		/* completions whose cid found the stack full */
+	uint16_t *inv_cid_stack;
+	uint32_t inv_cid_top;
+	uint32_t inv_cid_cap;
 };
 
