+/* inv 20-l1-trfree: no tracker, no outstanding list; the cid comes from the LIFO stack and req
+ * rides in the cb_fn slot (w4), which the unchanged device echoes in record w0. UNSAFE: in-flight
+ * IO cannot be aborted. A request the descriptor cannot carry fails loudly (no stock fallback:
+ * its tracker cid would collide with the stack's cids). */
+static int __attribute__((noinline))
+inv_trfree_submit(struct spdk_nvme_qpair *qpair, struct nvme_request *req)
+{
+	struct nvme_pcie_qpair *pqpair = nvme_pcie_qpair(qpair);
+	struct nvme_uncore_sq_desc_d *ring_d = (struct nvme_uncore_sq_desc_d *)pqpair->sq_desc_ring;
+	uint32_t _idx = pqpair->sq_desc_tail;
+	bool rw = req->cmd.opc == SPDK_NVME_OPC_READ || req->cmd.opc == SPDK_NVME_OPC_WRITE;
+
+	if (spdk_unlikely(req->payload_size > 131072u || !rw)) {
+		static bool inv_warned;
+
+		if (!inv_warned) {
+			inv_warned = true;
+			NVME_QPAIR_ERRLOG(qpair, "inv trfree: oracle cannot service this request "
+					  "(opc=0x%x payload_size=%u)\n", req->cmd.opc,
+					  req->payload_size);
+		}
+		return -ENOTSUP;
+	}
+	if (spdk_unlikely(pqpair->inv_cid_top == 0)) {
+		pqpair->stat->queued_requests++;
+		return -EAGAIN;
+	}
+	req->cmd.cid = pqpair->inv_cid_stack[--pqpair->inv_cid_top];
+	pqpair->stat->submitted_requests++;
+	pqpair->qpair.queue_depth++;
+	ring_d[_idx].w0 = ((uint64_t)(req->cmd.opc & 0xFFu) << 56) |
+			  ((uint64_t)(req->cmd.fuse & 0xFFu) << 48) |
+			  ((uint64_t)req->cmd.cid << 32) |
+			  ((uint64_t)(req->cmd.cdw12 & 0xFFFFu) << 16) |
+			  ((uint64_t)((req->cmd.cdw12 >> 16) & 0xFFFFu));
+	ring_d[_idx].w1 = (uint64_t)req->cmd.cdw10 | ((uint64_t)req->cmd.cdw11 << 32);
+	ring_d[_idx].w2 = 0;
+	ring_d[_idx].w3 = (uint64_t)(uintptr_t)req->cb_arg;
+	ring_d[_idx].w4 = (uint64_t)(uintptr_t)req;
+	pqpair->sq_desc_tail = (_idx + 1 == pqpair->num_entries) ? 0 : _idx + 1;
+	if (!pqpair->flags.delay_cmd_submit) {
+		nvme_pcie_qpair_ring_sq_doorbell(qpair);
+		pqpair->last_sq_desc_tail = pqpair->sq_desc_tail;
+	}
+	return 0;
+}
