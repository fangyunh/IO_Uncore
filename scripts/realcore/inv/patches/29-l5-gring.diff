+/* inv 29-l5-gring: consume the poll group's shared ring in ring order, at most budget records.
+ * The record is 20's trfree record, the LOCKED 32 B layout: w0 = req (echo of descriptor w4),
+ * w1 = cb_arg, w2/w3 = cpl with the ring phase at w3 bit 48, read like inv_rec_pop (w3 first).
+ * req->qpair names the member: its cid goes back on that qpair's 20 stack, its queue_depth drops
+ * and the completion is credited to it (inv_gring_done, returned by its own poll right after),
+ * then the callback runs and req is freed, the order of inv_records_trfree. */
+static inline __attribute__((always_inline)) uint32_t
+inv_gring_consume(struct inv_gring *g, uint32_t budget)
+{
+	uint32_t n = 0;
+
+	while (n < budget) {
