+/* inv 29-l5-gring: join the poll group's shared record ring at connect. Order relied on (perf:
+ * spdk_nvme_ctrlr_alloc_io_qpair with create_only, spdk_nvme_poll_group_add, then
+ * spdk_nvme_ctrlr_connect_io_qpair; spdk_nvme_poll_group_add only takes a DISCONNECTED qpair, so a
+ * qpair always joins its group before connect): (1) construct wrote the qpair's own record ring
+ * IOVA to CQ_REC_RING_IOVA[qid]; (2) the generic layer set qpair->poll_group; (3) connect lands
+ * here BEFORE the CREATE IO CQ admin command is submitted, so the register is rewritten with the
+ * shared ring's IOVA before nvmf_tgt reads it (at CREATE IO SQ, issued from the CQ completion);
+ * no IO can be submitted before the SQ exists. The first member allocates the ring. A reconnect
+ * of a member only rewrites the register (the target clears it on reset). */
+static int __attribute__((noinline, cold))
+inv_gring_join(struct nvme_pcie_qpair *pqpair)
+{
+	struct spdk_nvme_qpair *qpair = &pqpair->qpair;
+	struct nvme_pcie_ctrlr *pctrlr = nvme_pcie_ctrlr(qpair->ctrlr);
+	struct inv_gring *g;
+
+	if (qpair->poll_group == NULL) {
+		NVME_QPAIR_ERRLOG(qpair, "inv 29: IAU_INV_GLOBAL_RING=1|2 needs the IO qpair in a poll "
+				  "group before connect (per-poll-group ring only)\n");
+		return -ENOTSUP;
+	}
+	if (pctrlr->uncore_cq_rec_iova_reg == NULL) {
+		NVME_QPAIR_ERRLOG(qpair, "inv 29: the controller has no CQ_REC_RING_IOVA register\n");
+		return -ENOTSUP;
+	}
+	g = &SPDK_CONTAINEROF(qpair->poll_group, struct nvme_pcie_poll_group, group)->inv_gring;
+	if (pqpair->inv_gring != g) {
+		if (pqpair->inv_gring != NULL) {
+			NVME_QPAIR_ERRLOG(qpair, "inv 29: qpair still joined to another poll group\n");
+			return -EINVAL;
+		}
+		if (g->ring == NULL) {
+			/* Entries were validated at construct (same cache for every qpair). DMA memory
+			 * aligned to its power-of-two length, like the per-qpair record ring. */
+			uint32_t e = (uint32_t)g_inv_gring_entries;
+			size_t len = (size_t)e * sizeof(struct nvme_uncore_cq_cb_rec);
+			size_t align = spdk_max(spdk_align32pow2((uint32_t)len), (size_t)sysconf(_SC_PAGESIZE));
+			struct nvme_uncore_cq_cb_rec *ring;
+			uint64_t iova;
+
+			ring = spdk_zmalloc(len, align, NULL, SPDK_ENV_NUMA_ID_ANY, SPDK_MALLOC_DMA);
+			if (ring == NULL) {
+				NVME_QPAIR_ERRLOG(qpair, "inv 29: alloc of the shared record ring failed\n");
+				return -ENOMEM;
+			}
+			iova = nvme_pcie_vtophys(qpair->ctrlr, ring, NULL);
+			if (iova == SPDK_VTOPHYS_ERROR) {
+				NVME_QPAIR_ERRLOG(qpair, "inv 29: vtophys of the shared record ring failed\n");
+				spdk_free(ring);
+				return -EFAULT;
+			}
+			g->ring = ring;
+			g->bus_addr = iova;
+			g->consumed = 0;
+			g->head = 0;
+			g->phase = 1;	/* the device's first pass writes phase 1, like cq_rec_phase */
+			g->mode = (uint8_t)inv_gring_mode();	/* 1 or 2 (inv_gring_on implies on) */
+			g->entries = e;
+			g->members = 0;
+			g->inflight_cap = 0;
+			g->budget = 0;
+			fprintf(stderr, "INV_GRING ring=%p iova=0x%" PRIx64 " entries=%u mode=%u\n",
+				(void *)ring, iova, e, (unsigned)g->mode);
+		}
+		/* Flow control: the device may write ordinal k only once the host consumed k - entries.
+		 * Every unconsumed ordinal is an in-flight IO of a member, so the members' in-flight
+		 * bounds must sum to at most the ring size. */
+		if (g->inflight_cap + pqpair->inv_gring_cap > g->entries) {
+			NVME_QPAIR_ERRLOG(qpair, "inv 29: poll group in-flight bound %u + %u exceeds the "
+					  "shared ring's %u entries (raise IAU_INV_GLOBAL_RING_ENTRIES on "
+					  "both sides)\n", g->inflight_cap, pqpair->inv_gring_cap, g->entries);
+			return -ENOTSUP;
+		}
+		g->inflight_cap += pqpair->inv_gring_cap;
+		g->budget += pqpair->max_completions_cap;
+		g->members++;
+		pqpair->inv_gring = g;
+		fprintf(stderr, "INV_GRING qid=%u joined entries=%u ring=%p cap=%u group_cap=%u\n",
+			qpair->id, g->entries, (void *)g->ring, pqpair->inv_gring_cap, g->inflight_cap);
+	}
+	g_thread_mmio_ctrlr = pctrlr;
+	spdk_mmio_write_8(&pctrlr->uncore_cq_rec_iova_reg[qpair->id], g->bus_addr);
+	g_thread_mmio_ctrlr = NULL;
+	return 0;
+}
