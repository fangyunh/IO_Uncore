+/* inv 29-l5-gring: leave the poll group's ring (poll-group remove, or destroy as a safety net).
+ * The ring stays allocated until the poll group is destroyed; records of IO still in flight
+ * would still be consumed for this qpair (teardown with in-flight IO is not supported). */
+static void __attribute__((noinline, cold))
+inv_gring_leave(struct nvme_pcie_qpair *pqpair)
+{
+	struct inv_gring *g = pqpair->inv_gring;
+
+	g->inflight_cap -= pqpair->inv_gring_cap;
+	g->budget -= pqpair->max_completions_cap;
+	g->members--;
+	pqpair->inv_gring = NULL;
+}
