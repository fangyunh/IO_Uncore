+/* inv 25-l6-desc: the Mode D descriptor size, IAU_INV_DESC_BYTES = 32|40|64; unset or any other
+ * value = the LOCKED 40 B descriptor. nvmf_tgt parses the same env with the same rule
+ * (iau_inv_desc_init). Layouts, in 64-bit words: 40 B (LOCKED, struct nvme_uncore_sq_desc_d)
+ * w0 {opc, fuse, cid, nlb - 1, control}, w1 slba, w2 cookie (tr), w3 cb_arg, w4 cb_fn;
+ * 32 B drops the cookie (w2; the target never reads it, the host finds the tracker by cid):
+ * w0, w1, w3 -> word 2, w4 -> word 3, so every field the target decodes survives; 64 B is the
+ * 40 B descriptor with 24 B of padding never written or read, one per line. */
+static inline uint32_t
+inv_desc_bytes(void)
+{
+	int64_t v = inv_env_i64("IAU_INV_DESC_BYTES", &g_inv_desc_bytes, 40);
+
+	return (v == 32 || v == 64) ? (uint32_t)v : (uint32_t)sizeof(struct nvme_uncore_sq_desc_d);
+}
+
+/* inv 25: the env is set when it is non-empty (nvmf_tgt's rule for printing INV_DESC). */
+static inline bool
+inv_desc_env_set(void)
+{
+	if (spdk_unlikely(g_inv_desc_env_set < 0)) {
+		const char *e = getenv("IAU_INV_DESC_BYTES");
+
+		g_inv_desc_env_set = (e != NULL && e[0] != '\0');
+	}
+	return g_inv_desc_env_set == 1;
+}
+
+/* inv 25: write one Mode D descriptor at the configured stride; b = inv_desc_b. */
+static inline __attribute__((always_inline)) void
+inv_write_desc(struct nvme_pcie_qpair *pqpair, uint32_t idx, uint64_t w0, uint64_t w1, uint64_t w2,
+	       uint64_t w3, uint64_t w4)
+{
+	const uint32_t b = pqpair->inv_desc_b;
+	uint64_t *d = (uint64_t *)pqpair->sq_desc_ring + (size_t)idx * (b / 8);
+
+	d[0] = w0;
+	d[1] = w1;
+	if (b == 32) {
+		d[2] = w3;
+		d[3] = w4;
+	} else {
+		d[2] = w2;
+		d[3] = w3;
+		d[4] = w4;
+	}
+}
 
