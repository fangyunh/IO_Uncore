+/* inv 23/25: the cid pool this IO qpair uses (22 thin stack, else 20 trfree stack, else the
+ * tracker lists). Returns whole (no tracker left outstanding); *avail of *cap cids are free and
+ * *extra pushes found the pool full. The qpair is whole when whole && *avail == *cap && *extra == 0. */
+static bool
+inv_pool_state(const struct nvme_pcie_qpair *pqpair, uint32_t *cap, uint32_t *avail, uint64_t *extra)
+{
+	bool whole;
+
+	*avail = 0;
+	*extra = 0;
+	if (pqpair->inv_flags & INV_F_THIN) {
+		*cap = pqpair->inv_thin_cap;
+		*avail = pqpair->inv_thin_top;
+		*extra = pqpair->inv_thin_extra;
+		whole = true;
+	} else if (pqpair->inv_flags & INV_F_TRFREE) {
+		*cap = pqpair->inv_cid_cap;
+		*avail = pqpair->inv_cid_top;
+		*extra = pqpair->inv_cid_extra;
+		whole = true;
+	} else {
+		struct nvme_tracker *t;
+
+		*cap = (uint32_t)(pqpair->num_entries - pqpair->max_completions_cap);
+		TAILQ_FOREACH(t, &pqpair->free_tr, tq_list) {
+			(*avail)++;
+		}
+		whole = TAILQ_EMPTY(&pqpair->outstanding_tr);
+	}
+	return whole;
+}
