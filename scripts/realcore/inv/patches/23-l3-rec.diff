+/* inv 23-l3-rec: the stock Mode D completion loop (tracker by cid, lean recycle, the record's
+ * callback) for 16 B, 64 B and the 32 B control (INV_F_REC32); qpairs without a rec bit run the
+ * stock loop itself. Same steps in the same order as the stock loop of the lean build; per-IO
+ * cycle records are not taken here.
+ * 16 B: the callback is the qpair's inv_cb_fn. It is checked against tr->cb_fn, which the
+ * unchanged stock submit stores on the tracker line this loop already reads (tr->req), so the
+ * stock submit needs no lever code; the first completion registers it. */
+static inline __attribute__((always_inline)) uint32_t
+inv_records_tr(struct nvme_pcie_qpair *pqpair, uint32_t max_completions, const uint32_t words)
+{
+	uint64_t rec_cb_fn, rec_cb_arg, cpl_lo, cpl_hi;
+	uint32_t num_completions = 0;
+
+	while (inv_rec_pop(pqpair, words, &rec_cb_fn, &rec_cb_arg, &cpl_lo, &cpl_hi)) {
+		struct nvme_tracker *tr = &pqpair->tr[(uint16_t)((cpl_hi >> 32) & 0xFFFFu)];
+
+		if (spdk_likely(tr->req != NULL)) {
+			struct nvme_request *req = tr->req;
+			struct spdk_nvme_cpl cpl_rec;
+
+			if (words == 2) {
