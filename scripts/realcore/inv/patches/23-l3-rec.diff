+					inv_rec16_register(pqpair, tr->cb_fn);
+				}
+				rec_cb_fn = (uint64_t)(uintptr_t)pqpair->inv_cb_fn;
+			}
+			memcpy((uint8_t *)&cpl_rec + 0, &cpl_lo, 8);
+			memcpy((uint8_t *)&cpl_rec + 8, &cpl_hi, 8);
+			TAILQ_REMOVE(&pqpair->outstanding_tr, tr, tq_list);
+			pqpair->qpair.queue_depth--;
+			((spdk_nvme_cmd_cb)(uintptr_t)rec_cb_fn)((void *)(uintptr_t)rec_cb_arg, &cpl_rec);
+			nvme_free_request(req);
+			tr->req = NULL;
+			TAILQ_INSERT_HEAD(&pqpair->free_tr, tr, tq_list);
+		} else {
